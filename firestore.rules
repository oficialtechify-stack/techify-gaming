rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'rickmarketing81@gmail.com';
    }

    // Documento raiz da empresa
    match /companies/{companyId} {
      allow read: if (request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().companyId == companyId) ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      )) || (resource.data.status == 'approved' || resource.data.verified == true);

      allow create: if isAuthenticated() && (
        isAdmin() || (
          (request.resource.data.ownerId == request.auth.uid ||
           request.resource.data.userId == request.auth.uid ||
           request.resource.data.submittedBy == request.auth.uid) &&
          request.resource.data.status == 'draft' &&
          (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
          (!('banned' in request.resource.data) || request.resource.data.banned == false) &&
          !('stripeAccountId' in request.resource.data) &&
          !('stripeOnboardingStatus' in request.resource.data) &&
          (!('kyc_status' in request.resource.data) || request.resource.data.kyc_status == 'pending')
        )
      );

      allow update, delete: if isAuthenticated() && (
        isAdmin() || ((resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'banned', 'banReason', 'stripeAccountId', 'stripeOnboardingStatus', 'accountType', 'status', 'kyc_status', 'submittedAt', 'verificationSubmittedAt', 'ownerId', 'userId', 'submittedBy']))
      );
    }

    // Perfis de Usuário
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && (isAdmin() || (
        request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role != 'admin') &&
        (!('accountType' in request.resource.data) || request.resource.data.accountType != 'admin') &&
        (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
        (!('banned' in request.resource.data) || request.resource.data.banned == false)
      ));
      allow update: if isAuthenticated() && (isAdmin() || (
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountType', 'verified', 'verificationStatus', 'banned', 'banReason', 'companyId', 'isAdmin', 'activeRoleMode'])
      ));
      allow delete: if isAdmin();
    }

    match /user_profiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && (isAdmin() || (
        request.auth.uid == userId &&
        request.resource.data.accountType in ['afiliado', 'empresa', 'ambos'] &&
        request.resource.data.role != 'Administrador do Sistema' &&
        (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
        (!('banned' in request.resource.data) || request.resource.data.banned == false) &&
        (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus in ['draft', 'unsubmitted'])
      ));
      allow update: if isAuthenticated() && (isAdmin() || (
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType', 'role', 'partnerLevel', 'hasAffiliateProfile', 'hasCompanyProfile', 'activeRoleMode', 'banned', 'banReason', 'verificationReviewedAt', 'isAdmin', 'verified', 'verificationStatus', 'verificationSubmittedAt', 'kyc_status']) &&
        (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
        (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus in ['draft', 'unsubmitted']) &&
        (!('kyc_status' in request.resource.data) || request.resource.data.kyc_status == 'pending')
      ));
      allow delete: if isAdmin();
    }

    // Planos e Produtos com vínculo multi-tenant
    match /plans/{planId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().companyId == request.resource.data.companyId) ||
        request.resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().companyId == resource.data.companyId) ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Stripe sales are server-created only and readable only by the connected owner/affiliate or admin.
    match /sales/{saleId} {
      allow read: if isAuthenticated() && (
        resource.data.companyOwnerId == request.auth.uid ||
        resource.data.affiliateId == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    // Clientes isolados por empresa
    match /clients/{clientId} {
      allow read: if isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().companyId == resource.data.companyId ||
          getUserData().companyId == resource.data.store_id ||
          getUserData().companyId == resource.data.empresa_id
        )) ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().companyId == request.resource.data.companyId ||
          getUserData().companyId == request.resource.data.store_id ||
          getUserData().companyId == request.resource.data.empresa_id
        )) ||
        isAdmin()
      );
    }

    // Afiliações
    match /affiliations/{affId} {
      allow read: if isAuthenticated() && (
        resource.data.affiliateId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().companyId == resource.data.companyId) ||
        resource.data.companyOwnerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.affiliateId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().companyId == resource.data.companyId) ||
        isAdmin()
      );
    }

    // Saques
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().companyId == resource.data.companyId) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Solicitações de Verificação KYC
    match /verification_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin(); // Solicitudes KYC sólo se crean/actualizan desde funciones de servidor autenticadas.
    }

    // Cupons de desconto
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Push Subscriptions
    match /push_subscriptions/{subId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == subId || isAdmin());
    }

    // AgencyOS Webhook Logs & Settings
    match /agencyos_webhook_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /system_settings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /platform_finances/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
